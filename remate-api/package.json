{
  "name": "remate-api",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de Remate: validación de pujas, cierre y adjudicación (NestJS + Socket.IO + PostgreSQL)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "dev": "tsc -p tsconfig.json && node --env-file=.env dist/main.js",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/websockets": "11.1.6",
    "jose": "5.10.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.19.17",
    "@types/pg": "8.15.5",
    "jest": "29.7.0",
    "ts-jest": "29.4.4",
    "typescript": "5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"]
  }
}
